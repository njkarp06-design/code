<div class="posts">
    <% if (posts.length === 0) { %>
        <p class="text-muted">No posts to show.</p>
    <% } %>
    <% posts.forEach(post => { %>
        <div class="post">
            <h3><a href="<%= post.link %>" target="_blank"><%= post.title %></a></h3>
            <div class="meta">
                <span><%= new Date(post.pubDate).toDateString() %></span> |
                <span><%= post.creator %></span> |
                <span><%= post.categories ? post.categories.join(", ") : "" %></span>
            </div>
            <div class="content"><%- post.content %></div>
        </div>
    <% }) %>
</div>
